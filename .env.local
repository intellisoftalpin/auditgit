# Host port exposed by the container
ISA_PORT=18080

# Optional: pin a specific build tag (e.g. v0.0.1-20260101) instead of latest
ISA_IMAGE_TAG=latest

# Persisted directories on the host
ISA_DATA_HOST_DIR=./data
ISA_SSH_KEYS_HOST_DIR=./ssh_keys

# App logging level
LOG_LEVEL=info

# Container group mapping (auto-detected by make init)
# DOCKER_GID=1000

# Docker socket path (auto-detected by make init)
# Root Docker: /var/run/docker.sock
# Rootless Docker: /run/user/<uid>/docker.sock
# DOCKER_SOCK=/var/run/docker.sock
